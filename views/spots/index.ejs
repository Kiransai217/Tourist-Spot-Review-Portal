<%- include('../partials/header', { title }) %>
<section class="page-intro wrap"><div><div class="eyebrow"><span class="eyebrow-dot"></span> THE COMMUNITY GUIDE</div><h1>Find somewhere <em>remarkable.</em></h1><p>Local favourites, unforgettable views and honest advice from people who've been there.</p></div><a href="/spots/new" class="btn btn-dark">＋ Add a place</a></section>
<section class="wrap browse-section"><form class="filter-bar" method="GET" action="/spots"><div class="search-field"><span>⌕</span><input type="search" name="q" value="<%= filters.q %>" placeholder="Search places, cities, states..."></div><select name="category" aria-label="Filter by category"><option value="">All categories</option><% categories.forEach(cat => { %><option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option><% }) %></select><select name="sort" aria-label="Sort destinations"><option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Recently added</option><option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Highest rated</option><option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>Name A–Z</option></select><button class="btn btn-dark" type="submit">Find places ↗</button></form>
<div class="results-meta"><span><strong><%= spots.length %></strong> <%= spots.length === 1 ? 'destination' : 'destinations' %> to explore</span><span>Made better by community reviews</span></div>
<% if (!spots.length) { %><div class="empty-state"><div>⌕</div><h2>No places found just yet</h2><p>Try another search or be the first to add this destination.</p><a href="/spots/new" class="btn btn-dark">Add a place ↗</a></div><% } else { %><div class="spot-grid"><% spots.forEach(spot => { %><article class="spot-card"><a class="spot-photo" href="/spots/<%= spot._id %>"><img src="<%= spot.imageUrl || 'https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=900&q=80' %>" alt="<%= spot.name %>" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=900&q=80'"><span class="spot-category"><%= spot.category %></span><span class="photo-arrow">↗</span></a><div class="spot-content"><div class="spot-location">⌖ <%= spot.city %>, <%= spot.state %></div><a class="spot-title" href="/spots/<%= spot._id %>"><h2><%= spot.name %></h2></a><p class="spot-description"><%= spot.description.length > 110 ? spot.description.slice(0, 110) + '…' : spot.description %></p><div class="spot-card-bottom"><span class="rating"><span>★</span> <%= spot.averageRating ? spot.averageRating.toFixed(1) : 'New' %> <small>(<%= spot.reviews.length %>)</small></span><a href="/spots/<%= spot._id %>" class="text-link">Details ↗</a></div></div></article><% }) %></div><% } %>
</section><%- include('../partials/footer') %>
