<%- include('../partials/header', { title }) %>
<section class="detail-page wrap"><a href="/spots" class="back-link">← All destinations</a><div class="detail-hero"><img src="<%= spot.imageUrl || 'https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1400&q=85' %>" alt="<%= spot.name %>" onerror="this.src='https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1400&q=85'"><span class="detail-category"><%= spot.category %></span></div><div class="detail-layout"><article class="detail-main"><div class="eyebrow"><span class="eyebrow-dot"></span> A SPOTSCOUT DISCOVERY</div><h1><%= spot.name %></h1><div class="detail-location">⌖ <%= spot.city %>, <%= spot.state %> <span>·</span> Added by <%= spot.createdBy ? spot.createdBy.name : 'a traveller' %></div><div class="detail-rating"><span>★</span> <strong><%= spot.averageRating ? spot.averageRating.toFixed(1) : 'New' %></strong><span class="muted">· <%= spot.reviews.length %> <%= spot.reviews.length === 1 ? 'review' : 'reviews' %></span></div><div class="detail-description"><h2>About this place</h2><p><%= spot.description %></p></div><div class="review-heading"><div><div class="eyebrow">TRAVELLER NOTES</div><h2>Reviews from the community</h2></div><span class="review-count"><%= reviews.length %></span></div>
<% if (!reviews.length) { %><div class="no-reviews"><span>✳</span><strong>Be the first to leave a review.</strong><p>Your experience could help someone plan a better trip.</p></div><% } else { %><div class="reviews-list"><% reviews.forEach(review => { %><article class="review-card"><div class="review-avatar"><%= (review.userName || 'T').charAt(0).toUpperCase() %></div><div class="review-body"><div class="review-top"><strong><%= review.userName %></strong><span class="review-stars"><%= '★'.repeat(review.rating) %><span class="empty-stars"><%= '★'.repeat(5-review.rating) %></span></span></div><small class="review-date"><%= new Date(review.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></small><p><%= review.comment %></p><% if (currentUser && review.user && review.user._id.toString() === currentUser.id) { %><form method="POST" action="/spots/<%= spot._id %>/reviews/<%= review._id %>?_method=DELETE" onsubmit="return confirm('Delete your review?')"><button class="delete-link" type="submit">Delete my review</button></form><% } %></div></article><% }) %></div><% } %>
<% if (currentUser) { const hasReviewed = spot.reviews.some(review => review.user && review.user._id.toString() === currentUser.id); if (!hasReviewed) { %><div class="review-form-card"><h3>Been here? Leave a review.</h3><p>Keep it honest and helpful for the next traveller.</p><form method="POST" action="/spots/<%= spot._id %>/reviews" class="form-stack"><label>Your rating<select name="rating" required><option value="">Choose a rating</option><option value="5">★★★★★ — Loved it</option><option value="4">★★★★☆ — Really good</option><option value="3">★★★☆☆ — It was okay</option><option value="2">★★☆☆☆ — Could be better</option><option value="1">★☆☆☆☆ — Not for me</option></select></label><label>Your review<textarea name="comment" required minlength="5" maxlength="1000" rows="4" placeholder="What should other visitors know?"></textarea></label><button class="btn btn-dark" type="submit">Post review ↗</button></form></div><% } else { %><p class="already-reviewed">Thanks for sharing your experience — you've already reviewed this place.</p><% } } else { %><div class="review-form-card"><h3>Your experience matters.</h3><p>Log in to share a rating and help other travellers.</p><a class="btn btn-dark" href="/login">Log in to review ↗</a></div><% } %>
</article><aside class="detail-aside"><div class="info-card"><div class="eyebrow">PLAN YOUR VISIT</div><div class="info-row"><span class="info-icon">◷</span><div><small>BEST TIME TO VISIT</small><strong><%= spot.bestTime %></strong></div></div><div class="info-row"><span class="info-icon">₹</span><div><small>ENTRY FEE</small><strong><%= spot.entryFee %></strong></div></div><div class="info-row"><span class="info-icon">⌖</span><div><small>LOCATION</small><strong><%= spot.city %>, <%= spot.state %></strong></div></div><div class="info-note">Tip: Confirm current opening hours and local travel conditions before setting off.</div><% if (currentUser && spot.createdBy && spot.createdBy._id.toString() === currentUser.id) { %><form method="POST" action="/spots/<%= spot._id %>?_method=DELETE" onsubmit="return confirm('Delete this destination and its reviews?')"><button class="btn btn-danger btn-full" type="submit">Delete this destination</button></form><% } %></div><div class="aside-quote"><span>“</span><p>The best recommendations come from people who've actually been there.</p><small>THE SPOTSCOUT IDEA</small></div></aside></div></section>
<%- include('../partials/footer') %>
