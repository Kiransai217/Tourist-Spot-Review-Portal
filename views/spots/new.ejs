<%- include('../partials/header', { title }) %>
<section class="form-page wrap"><a href="/spots" class="back-link">← Back to destinations</a><div class="form-heading"><div class="eyebrow"><span class="eyebrow-dot"></span> SHARE THE DISCOVERY</div><h1>Add a place worth <em>knowing.</em></h1><p>Tell the community about a destination you recommend. You can add a photo URL or use the category image.</p></div><% if (errors.length) { %><div class="form-errors"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %><form method="POST" action="/spots" class="spot-form"><div class="form-grid"><label>Destination name *<input name="name" required maxlength="100" placeholder="e.g. Araku Valley"></label><label>Category<select name="category"><% categories.forEach(cat => { %><option value="<%= cat %>"><%= cat %></option><% }) %></select></label><label>City / town *<input name="city" required maxlength="80" placeholder="e.g. Visakhapatnam"></label><label>State / region *<input name="state" required maxlength="80" placeholder="e.g. Andhra Pradesh"></label><label class="full-field">Photo URL (optional)<input type="url" name="imageUrl" placeholder="https://example.com/photo.jpg"><small>Use a direct image URL. Leave blank for a category image.</small></label><label>Best time to visit<input name="bestTime" maxlength="120" placeholder="e.g. October to February"></label><label>Entry fee<input name="entryFee" maxlength="100" placeholder="e.g. Free / ₹50 per person"></label><label class="full-field">Description *<textarea name="description" required minlength="10" maxlength="2000" rows="5" placeholder="What makes this place special? Share helpful details for other travellers..."></textarea></label></div><div class="form-actions"><a class="btn btn-light" href="/spots">Cancel</a><button class="btn btn-dark" type="submit">Publish destination <span>↗</span></button></div></form></section>
<%- include('../partials/footer') %>
