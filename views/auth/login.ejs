<%- include('../partials/header', { title }) %>
<section class="auth-layout wrap"><div class="auth-art"><div class="eyebrow eyebrow-light">WELCOME BACK, EXPLORER</div><h2>The world is full<br>of <em>good surprises.</em></h2><p>Pick up where you left off and find somewhere new to explore.</p><img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=80" alt="Mountain range at sunrise"></div><div class="auth-panel"><a href="/" class="back-link">← Back to home</a><h1>Welcome back</h1><p class="muted">Log in to share reviews and discoveries.</p><% if (errors.length) { %><div class="form-errors"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %><form method="POST" action="/login" class="form-stack"><label>Email address<input type="email" name="email" required placeholder="you@example.com" autocomplete="email"></label><label>Password<input type="password" name="password" required placeholder="Your password" autocomplete="current-password"></label><button class="btn btn-dark btn-full" type="submit">Log in <span>↗</span></button></form><p class="auth-switch">New to SpotScout? <a href="/register">Create an account</a></p><small class="privacy-note">Create an account first if you are a new user.</small></div></section>
<%- include('../partials/footer') %>
