<%- include('../partials/header', { title }) %>
<section class="auth-layout wrap"><div class="auth-art"><div class="eyebrow eyebrow-light">YOUR JOURNEY, YOUR STORIES</div><h2>Every great trip<br>starts with a <em>discovery.</em></h2><p>Join a community sharing the places that make travelling memorable.</p><img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1000&q=80" alt="Scenic landscape"></div><div class="auth-panel"><a href="/" class="back-link">← Back to home</a><h1>Create your account</h1><p class="muted">Save your discoveries and share your own.</p><% if (errors.length) { %><div class="form-errors"><% errors.forEach(error => { %><p><%= error.msg %></p><% }) %></div><% } %><form method="POST" action="/register" class="form-stack"><label>Full name<input name="name" required minlength="2" maxlength="60" placeholder="Your name"></label><label>Email address<input type="email" name="email" required placeholder="you@example.com"></label><label>Password<input type="password" name="password" required minlength="6" placeholder="At least 6 characters"></label><button class="btn btn-dark btn-full" type="submit">Create account <span>↗</span></button></form><p class="auth-switch">Already have an account? <a href="/login">Log in</a></p><small class="privacy-note">Your account details are used only for this portal.</small></div></section>
<%- include('../partials/footer') %>
